# Merge these values into the existing root .env; preserve existing secrets.
# Replica overlay workflow/rental flags override backend/.env.
# CLIENT_PORTAL_ENABLED remains configured in backend/.env.
CLIENT_WORKFLOW_ENABLED=false
CLIENT_RENTAL_ENABLED=false
# Frontend flags are build-time values; rebuild after changing them.
VITE_CLIENT_PORTAL_ENABLED=true
VITE_CLIENT_RENTAL_ENABLED=false
